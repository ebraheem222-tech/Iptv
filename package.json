{
  "name": "nova-tv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,TV \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "node scripts/build.mjs",
    "build:tv": "npm run build && node scripts/package-tv.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "hls.js": "^1.6.13",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.10",
    "vite": "^6.3.6"
  }
}
